# ==================== 数据库配置 ====================
# 设置后使用 PostgreSQL (Supabase)，留空则使用本地 SQLite
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ==================== 安全配置（生产环境必须修改） ====================
# 应用密钥（留空则自动生成随机密钥）
PDS_SECRET_KEY=
# JWT 签名密钥（留空则自动生成随机密钥）
PDS_JWT_SECRET_KEY=
# CORS 允许的域名（逗号分隔，生产环境必须设置）
PDS_CORS_ORIGINS=

# ==================== SMTP 邮件（可选） ====================
PDS_SMTP_HOST=smtp.126.com
PDS_SMTP_PORT=587
PDS_SMTP_USER=your-email@qq.com
PDS_SMTP_PASSWORD=your-auth-code
PDS_SMTP_FROM=your-email@qq.com
PDS_SMTP_USE_TLS=true

# ==================== 阿里云短信认证（可选） ====================
PDS_ALIYUN_ACCESS_KEY_ID=
PDS_ALIYUN_ACCESS_KEY_SECRET=
PDS_ALIYUN_SMS_SIGN_NAME=
PDS_ALIYUN_SMS_TEMPLATE_CODE=